# /etc/xdg/labwc-gtk-greeter/autostart
# Runs the lightdm gtk-greeter (which HAS a session chooser) inside labwc/Wayland,
# so it never touches Xorg (Xorg cannot init the uConsole DSI/vc4-kms panel).
# Clone the working /etc/xdg/labwc-greeter dir first, then drop this file in.
# NOTE: the greeter binary is /usr/sbin/lightdm-gtk-greeter and is NOT on PATH,
#       so the absolute path is mandatory — a bare name yields "not found".
wlr-randr --output DSI-1 --transform 270 &
wlr-randr --output DSI-2 --transform 270 &
/usr/bin/kanshi -c /etc/xdg/labwc-gtk-greeter/config.kanshi &
/usr/sbin/lightdm-gtk-greeter &
