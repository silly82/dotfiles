# ~/.config/sway/config for ClockworkPi uConsole (CM4)
# Adjust the output line to values discovered from ~/.config/kanshi/config.
# CM4 panel: DSI-1, transform 270, scale 1.5  ->  effective ~853x480 landscape.
# CM5 may present the panel as DSI-2.

### Output: rotate the portrait DSI panel into landscape #####################
output DSI-1 transform 270 scale 1.5
# If the panel is DSI-2 (CM5), use instead:
# output DSI-2 transform 270 scale 1.5

### Keyboard: uConsole has NO Super/Win key — remap left Alt to Super ########
# Left Alt now sends Super_L ($mod); right Alt stays a normal Alt.
# Verify option exists: grep -i altwin /usr/share/X11/xkb/rules/base.lst
# Plan B (if left-Alt still won't send Super): use altwin:alt_win instead.
input type:keyboard {
    xkb_options altwin:swap_lalt_lwin
}

### Small-screen ergonomics ##################################################
set $mod Mod4
font pango:monospace 9
gaps inner 2
gaps outer 0
default_border pixel 1
smart_borders on

### Programs #################################################################
set $term foot
set $menu wmenu-run
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

### Focus / move (vim keys + arrows) #########################################
set $left h
set $down j
set $up k
set $right l
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

### Workspaces ###############################################################
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2

### uConsole hardware keys (PipeWire/WirePlumber + brightnessctl) ############
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp   exec brightnessctl set 10%+
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

### Idle / lock (optional) ###################################################
# exec swayidle -w timeout 300 'swaylock -f' timeout 600 'swaymsg "output * dpms off"' \
#   resume 'swaymsg "output * dpms on"'

### Status bar ###############################################################
# If waybar is installed, prefer it; otherwise the built-in bar:
bar {
    position top
    status_command while date +'%Y-%m-%d %H:%M'; do sleep 30; done
    font pango:monospace 9
}

# Pull in Debian's split default vars if present
include /etc/sway/config-vars.d/*
